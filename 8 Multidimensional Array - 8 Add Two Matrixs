import java.util.Scanner;

public class AddMatrices {

    // Method to add two matrices
    public static double[][] addMatrix(double[][] a, double[][] b) {
        double[][] c = new double[a.length][a[0].length];

        for (int i = 0; i < a.length; i++) {
            for (int j = 0; j < a[i].length; j++) {
                c[i][j] = a[i][j] + b[i][j];
            }
        }

        return c;
    }

    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        double[][] a = new double[3][3];
        double[][] b = new double[3][3];

        System.out.println("Enter matrix1 (3x3):");
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                a[i][j] = input.nextDouble();
            }
        }

        System.out.println("Enter matrix2 (3x3):");
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                b[i][j] = input.nextDouble();
            }
        }

        double[][] c = addMatrix(a, b);

        System.out.println("\nThe matrices are added as follows:");

        for (int i = 0; i < 3; i++) {

            // Print first matrix
            for (int j = 0; j < 3; j++) {
                System.out.printf("%6.1f", a[i][j]);
            }

            if (i == 1)
                System.out.print("  +  ");
            else
                System.out.print("     ");

            // Print second matrix
            for (int j = 0; j < 3; j++) {
                System.out.printf("%6.1f", b[i][j]);
            }

            if (i == 1)
                System.out.print("  =  ");
            else
                System.out.print("     ");

            // Print result matrix
            for (int j = 0; j < 3; j++) {
                System.out.printf("%6.1f", c[i][j]);
            }

            System.out.println();
        }

        input.close();
    }
}