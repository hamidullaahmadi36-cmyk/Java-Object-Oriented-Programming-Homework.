public class GradeExam {

    public static void main(String[] args) {

        // Students' answers
        char[][] answers = {
            {'A', 'B', 'A', 'C', 'C', 'D', 'E', 'E', 'A', 'D'},
            {'D', 'B', 'A', 'B', 'C', 'A', 'E', 'E', 'A', 'D'},
            {'E', 'D', 'D', 'A', 'C', 'B', 'E', 'E', 'A', 'D'},
            {'C', 'B', 'A', 'E', 'D', 'C', 'E', 'E', 'A', 'D'},
            {'A', 'B', 'D', 'C', 'C', 'D', 'E', 'E', 'A', 'D'},
            {'B', 'B', 'E', 'C', 'C', 'D', 'E', 'E', 'A', 'D'},
            {'B', 'B', 'A', 'C', 'C', 'D', 'E', 'E', 'A', 'D'},
            {'E', 'B', 'E', 'C', 'C', 'D', 'E', 'E', 'A', 'D'}
        };

        // Answer key
        char[] keys = {'D', 'B', 'D', 'C', 'C', 'D', 'A', 'E', 'A', 'D'};

        int[] correctCounts = new int[answers.length];

        // Count correct answers
        for (int i = 0; i < answers.length; i++) {
            int correct = 0;
            for (int j = 0; j < answers[i].length; j++) {
                if (answers[i][j] == keys[j]) {
                    correct++;
                }
            }
            correctCounts[i] = correct;
        }

        // Sort students by number of correct answers (ascending)
        for (int i = 0; i < correctCounts.length - 1; i++) {
            for (int j = i + 1; j < correctCounts.length; j++) {
                if (correctCounts[i] > correctCounts[j]) {

                    // Swap scores
                    int tempScore = correctCounts[i];
                    correctCounts[i] = correctCounts[j];
                    correctCounts[j] = tempScore;

                    // Swap student indices
                    char[] tempAnswer = answers[i];
                    answers[i] = answers[j];
                    answers[j] = tempAnswer;
                }
            }
        }

        // Display students in increasing order
        for (int i = 0; i < correctCounts.length; i++) {
            System.out.println("Student " + i +
                    "'s correct count is " + correctCounts[i]);
        }
    }
}