import java.util.Scanner;

public class AverageArray {

    // Method to find the average of an int array
    public static double average(int[] array) {
        int sum = 0;

        for (int i = 0; i < array.length; i++) {
            sum += array[i];
        }

        return (double) sum / array.length;
    }

    // Overloaded method to find the average of a double array
    public static double average(double[] array) {
        double sum = 0;

        for (int i = 0; i < array.length; i++) {
            sum += array[i];
        }

        return sum / array.length;
    }

    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        int[] intArray = new int[10];
        double[] doubleArray = new double[10];

        // Read 10 integers
        System.out.println("Enter 10 integers:");
        for (int i = 0; i < intArray.length; i++) {
            intArray[i] = input.nextInt();
        }

        System.out.println("Average of integers: " + average(intArray));

        // Read 10 doubles
        System.out.println("\nEnter 10 double values:");
        for (int i = 0; i < doubleArray.length; i++) {
            doubleArray[i] = input.nextDouble();
        }

        System.out.println("Average of doubles: " + average(doubleArray));

        input.close();
    }
}