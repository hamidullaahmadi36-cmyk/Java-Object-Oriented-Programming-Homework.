public class WeeklyHours {
    public static void main(String[] args) {


        int[][] hours = {
            {2, 4, 3, 4, 5, 8, 8},
            {7, 3, 4, 3, 3, 4, 4},
            {3, 3, 4, 3, 3, 2, 2},
            {9, 3, 4, 7, 3, 4, 1},
            {3, 5, 4, 3, 6, 3, 8},
            {3, 4, 4, 6, 3, 4, 4},
            {3, 7, 4, 8, 3, 8, 4},
            {6, 3, 5, 9, 2, 7, 9}
        };

        // Store employee number and total hours
        int[][] totalHours = new int[hours.length][2];

        // Compute total hours
        for (int i = 0; i < hours.length; i++) {
            totalHours[i][0] = i; // Employee ID
            int sum = 0;

            for (int j = 0; j < hours[i].length; j++) {
                sum += hours[i][j];
            }

            totalHours[i][1] = sum;
        }

        // Sort by total hours (descending)
        for (int i = 0; i < totalHours.length - 1; i++) {
            for (int j = i + 1; j < totalHours.length; j++) {
                if (totalHours[i][1] < totalHours[j][1]) {

                    int tempId = totalHours[i][0];
                    int tempHours = totalHours[i][1];

                    totalHours[i][0] = totalHours[j][0];
                    totalHours[i][1] = totalHours[j][1];

                    totalHours[j][0] = tempId;
                    totalHours[j][1] = tempHours;
                }
            }
        }


        System.out.println("Employee\tTotal Hours");
        for (int i = 0; i < totalHours.length; i++) {
            System.out.println("Employee " + totalHours[i][0]
                    + "\t" + totalHours[i][1]);
        }
    }
}