import java.util.Random;

public class RandomNumbers {

    public static void main(String[] args) {

        Random random = new Random(1000);

        for (int i = 1; i <= 50; i++) {
            int number = random.nextInt(100);
            System.out.printf("%4d", number);

            // Print 10 numbers per line
            if (i % 10 == 0) {
                System.out.println();
            }
        }
    }
}