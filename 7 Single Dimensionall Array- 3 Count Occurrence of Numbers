import java.util.Scanner;

public class CountOccurrence {

    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        // Array to count occurrences of numbers 1-100
        int[] count = new int[101];

        System.out.println("Enter integers between 1 and 100 (0 to end):");

        int number;

        // Read numbers until 0 is entered
        while (true) {
            number = input.nextInt();

            if (number == 0) {
                break;
            }

            if (number >= 1 && number <= 100) {
                count[number]++;
            }
        }

        // Display the occurrences
        System.out.println("\nOccurrences:");

        for (int i = 1; i <= 100; i++) {
            if (count[i] > 0) {
                if (count[i] == 1) {
                    System.out.println(i + " occurs " + count[i] + " time");
                } else {
                    System.out.println(i + " occurs " + count[i] + " times");
                }
            }
        }

        input.close();
    }
}